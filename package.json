{
  "name": "inc-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "build:gateway": "nest build gateway",
    "build:storage": "nest build storage",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:gateway": "cross-env ENV=PRODUCTION node dist/apps/gateway/main",
    "start:storage": "cross-env ENV=PRODUCTION node dist/apps/storage/main",
    "start:dev": "cross-env ENV=DEVELOPMENT nest start --watch",
    "start:dev:gateway": "cross-env ENV=DEVELOPMENT nest start gateway --watch",
    "start:dev:storage": "cross-env ENV=DEVELOPMENT nest start storage --watch",
    "start:dev:payments": "cross-env ENV=DEVELOPMENT nest start payments --watch",
    "start:debug": "nest start --debug --watch",
    "start:debug:gateway": "nest start gateway --debug --watch",
    "start:debug:storage": "nest start storage --debug --watch",
    "start:prod:gateway": "dotenv -e .env.gateway.production -- cross-env ENV=PRODUCTION npx prisma migrate deploy --schema=./apps/gateway/prisma/schema.prisma && cross-env ENV=PRODUCTION npx prisma generate --schema=./apps/gateway/prisma/schema.prisma && cross-env ENV=PRODUCTION node dist/apps/gateway/main",
    "start:prod:storage": "dotenv -e .env.storage.production -- cross-env ENV=PRODUCTION node dist/apps/storage/main",
    "start:prod:payments": "dotenv -e .env.payments.production -- cross-env ENV=PRODUCTION node dist/apps/payments/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:gateway:e2e": "dotenv -e .env.gateway.test -- cross-env ENV=TEST npx prisma migrate deploy --schema=./apps/gateway/prisma/schema.prisma && cross-env ENV=TEST npx prisma generate --schema=./apps/gateway/prisma/schema.prisma && cross-env ENV=TEST jest --config apps/gateway/test/e2e/jest-e2e.json --runInBand --detectOpenHandles",
    "test:gateway:unit": "dotenv -e .env.gateway.test -- cross-env ENV=TEST npx prisma migrate deploy --schema=./apps/gateway/prisma/schema.prisma && cross-env ENV=TEST npx prisma generate --schema=./apps/gateway/prisma/schema.prisma && cross-env ENV=TEST jest --config apps/gateway/test/unit/jest-unit.json --runInBand --detectOpenHandles",
    "test:gateway:inegration": "jest --config apps/gateway/test/integration/jest-integration.json --runInBand --detectOpenHandles",
    "tsc:gateway:check": "tsc --p apps/gateway/tsconfig.app.json --noEmit",
    "tsc:storage:check": "tsc --p apps/storage/tsconfig.app.json --noEmit",
    "generate:prisma": "npx prisma generate --schema=./apps/gateway/prisma/schema.prisma",
    "migrate:deploy": "npx prisma migrate deploy --schema=./apps/gateway/prisma/schema.prisma",
    "test:storage:e2e": "dotenv -e .env.storage.test -- cross-env ENV=TEST jest --config apps/storage/test/e2e/jest-e2e.json --runInBand --detectOpenHandles",
    "test:storage:unit": "dotenv -e .env.storage.test -- cross-env ENV=TEST jest --config apps/storage/test/unit/jest-unit.json --runInBand --detectOpenHandles",
    "test:storage:inegration": "dotenv -e .env.storage.test -- cross-env ENV=TEST jest --config apps/storage/test/integration/jest-integration.json --runInBand --detectOpenHandles",
    "test:payments:e2e": "dotenv -e .env.gateway.test -- cross-env ENV=TEST  jest --config apps/payments/test/e2e/jest-e2e.json --runInBand --detectOpenHandles",
    "test:payments:unit": "dotenv -e .env.gateway.test -- cross-env ENV=TEST jest --config apps/payments/test/unit/jest-unit.json --runInBand --detectOpenHandles",
    "test:payments:inegration": "dotenv -e .env.gateway.test -- cross-env ENV=TEST jest --config apps/payments/test/integration/jest-integration.json --runInBand --detectOpenHandles",
    "migration:dev:generate": "cross-env ENV=DEVELOPMENT typeorm-ts-node-commonjs migration:generate apps/storage/src/core/db/migrations/migrations -d apps/storage/src/core/db/typeorm.config.ts",
    "migration:dev:create": "cross-env ENV=DEVELOPMENT typeorm-ts-node-commonjs migration:create",
    "migration:dev:run": "cross-env ENV=DEVELOPMENT typeorm-ts-node-commonjs migration:run -d apps/storage/src/core/db/typeorm.config.ts",
    "migration:dev:revert": "cross-env ENV=DEVELOPMENT typeorm-ts-node-commonjs migration:revert -d typeorm.config.ts",
    "migration:prod:run": "cross-env ENV=PRODUCTION typeorm-ts-node-commonjs migration:run -d apps/storage/src/core/db/typeorm.config.ts",
    "migration:test:run": "cross-env ENV=TEST typeorm-ts-node-commonjs migration:run -d apps/storage/src/core/db/typeorm.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.651.1",
    "@aws-sdk/lib-storage": "^3.679.0",
    "@aws-sdk/s3-request-presigner": "^3.682.0",
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/axios": "^3.0.3",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.0.0",
    "@nestjs/cqrs": "^10.2.7",
    "@nestjs/event-emitter": "^2.0.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/sequelize": "^10.0.1",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.3.0",
    "@nestjs/typeorm": "^11.0.0",
    "@prisma/client": "^6.1.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/multer": "^1.4.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/sequelize": "^4.28.20",
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.6",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "handlebars": "^4.7.8",
    "nodemailer": "^6.9.15",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "paypal-rest-sdk": "^1.8.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6",
    "sharp": "^0.33.5",
    "stripe": "^17.4.0",
    "typeorm": "^0.3.20",
    "ua-parser-js": "^1.0.39"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.5.5",
    "@types/nodemailer": "^6.4.16",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/paypal__checkout-server-sdk": "^1.0.8",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^2.0.12",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^6.1.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/"
    ]
  }
}
